# .env.example
# AUTO-GENERATED from secrets.yaml by scripts/gen-env-example.sh.
# DO NOT EDIT BY HAND — your changes will be overwritten on the next run.
#
# To use locally:
#   cp .env.example .env.local
#   Then fill in REAL VALUES in .env.local (which is gitignored).

# ---------------------------------------------------------------------------
# Non-secret runtime configuration (NOT in secrets.yaml — just env wiring)
# ---------------------------------------------------------------------------

# ENVIRONMENT — one of: local | staging | production.
ENVIRONMENT=local

# LOG_LEVEL — Python logging threshold (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# LANGFUSE_TRACING_ENABLED — set "true" to ship LLM traces to rishi-6.
# Default "false" so local development doesn't need real Langfuse keys.
LANGFUSE_TRACING_ENABLED=false


# ---------------------------------------------------------------------------
# Secrets (1-to-1 with secrets.yaml declarations)
# ---------------------------------------------------------------------------

# REDIS_URL
#   Redis connection URL. **MUST be PASSWORDLESS** —
#   `REDIS_PASSWORD` is the sole AUTH source per the round-8
#   contract. Production format:
#     redis://<sentinel-or-primary-host>:6379/0
#   (NOT `redis://:<password>@<host>:6379/0` — the redis-py URL
#   parser takes URL-embedded credentials over the `password=`
#   keyword argument, which would silently bypass the
#   `REDIS_PASSWORD` Swarm secret. Codex PR #137 round-7
#   BLOCKER 1 flagged this ambiguity.)
#   Used by:
#     - app/redis_client.py — singleton `redis.Redis.from_url(...)`
#       that backs the JWKS cache (per E9) + the F10 idempotency-
#       dedup cache. Forwards `REDIS_PASSWORD` via the `password=`
#       argument.
#     - app/api/health_routes.py — async Sentinel-aware ping per
#       C11 (Sentinel-quorum primary discovery + reconnect-on-
#       failover). Forwards `REDIS_PASSWORD` via the `password=`
#       argument on `Sentinel.master_for()`.
#   Per C11 production uses the Sentinel quorum (3 sentinels on
#   rishi-4/5/6); local development + docker-compose use a single-primary
#   URL (`redis://localhost:6379/0`) — the docker-compose Redis
#   is unauthenticated so `REDIS_PASSWORD` is empty locally.
# Source: local=.env.local (e.g. redis://localhost:6379/0)
#         ci=GitHub Secret REDIS_URL
#         production=GitHub Secret REDIS_URL → Swarm secret at deploy
REDIS_URL=redis://localhost:6379/0

# REDIS_PASSWORD
#   Password sent to the Redis primary in response to its AUTH
#   challenge. The v2 cluster's Redis primary runs with
#   `--requirepass` enabled; every connection to the primary
#   MUST AUTH or first command raises
#   `redis.exceptions.AuthenticationError: Authentication required.`
#   
#   **This is the SOLE AUTH source.** Per the round-8 contract
#   (Codex PR #137 round-7 BLOCKER 1 fix), `REDIS_URL` MUST be
#   passwordless — embedding credentials in the URL would silently
#   take precedence over the `password=` keyword argument that
#   forwards this secret, bypassing the Swarm-secret-managed
#   rotation pattern.
#   
#   Consumed by BOTH Redis paths in this service:
#     - app/redis_client.py — passed as the `password=` keyword
#       argument to redis.Redis.from_url() (JWKS-cache +
#       idempotency-dedup singleton)
#     - app/api/health_routes.py — passed as the `password=`
#       keyword argument to Sentinel.master_for() (C11
#       /health/ready probe)
# Source: local=Not required — local docker-compose Redis runs without --requirepass
#         ci=GitHub Secret REDIS_PASSWORD
#         production=Swarm secret yral_v2_redis_primary_password_<sha> mapped to logical name REDIS_PASSWORD via compose external:name
REDIS_PASSWORD=

# SENTRY_DSN
#   Sentry DSN for THIS service's project at sentry.rishi.yral.com
#   (NOT apm.yral.com per A7). The middleware (added Day 2) auto-tags
#   every event with service=yral-rishi-agent-public-api per D3.
# Source: local=.env.local (use a development Sentry project so local errors don't pollute production)
#         ci=GitHub Secret SENTRY_DSN
#         production=GitHub Secret SENTRY_DSN → Swarm secret at deploy
SENTRY_DSN=

# LANGFUSE_PUBLIC_KEY
#   Langfuse project public key. Identifies which Langfuse project the
#   service's LLM traces land in. Paired with LANGFUSE_SECRET_KEY.
#   Per D4 every service auto-traces LLM calls to langfuse.rishi.yral.com.
# Source: local=.env.local (optional — LANGFUSE_TRACING_ENABLED=false locally avoids needing real keys)
#         ci=GitHub Secret LANGFUSE_PUBLIC_KEY
#         production=GitHub Secret LANGFUSE_PUBLIC_KEY → Swarm secret at deploy
LANGFUSE_PUBLIC_KEY=

# LANGFUSE_SECRET_KEY
#   Langfuse project secret key. Paired with LANGFUSE_PUBLIC_KEY. The
#   SDK signs every trace-ingestion call with this key.
# Source: local=.env.local (optional — see LANGFUSE_PUBLIC_KEY above)
#         ci=GitHub Secret LANGFUSE_SECRET_KEY
#         production=GitHub Secret LANGFUSE_SECRET_KEY → Swarm secret at deploy
LANGFUSE_SECRET_KEY=
