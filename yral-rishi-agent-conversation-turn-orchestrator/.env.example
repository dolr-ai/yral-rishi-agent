# .env.example
# AUTO-GENERATED from secrets.yaml by scripts/gen-env-example.sh.
# DO NOT EDIT BY HAND — your changes will be overwritten on the next run.
#
# To use locally:
#   cp .env.example .env.local
#   Then fill in REAL VALUES in .env.local (which is gitignored).

# ---------------------------------------------------------------------------
# Non-secret runtime configuration (NOT in secrets.yaml — just env wiring)
# ---------------------------------------------------------------------------

# ENVIRONMENT — one of: local | staging | production.
ENVIRONMENT=local

# LOG_LEVEL — Python logging threshold (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# LANGFUSE_TRACING_ENABLED — set "true" to ship LLM traces to rishi-6.
# Default "false" so local dev doesn't need real Langfuse keys.
LANGFUSE_TRACING_ENABLED=false


# ---------------------------------------------------------------------------
# Secrets (1-to-1 with secrets.yaml declarations)
# ---------------------------------------------------------------------------

# REDIS_URL
#   Redis connection string used by the F10 idempotency-dedup layer
#   (`app/idempotency.py`) + the Sentinel-aware client when
#   `REDIS_SENTINEL_ENABLED=true`. Format:
#     redis://:<password>@<host>:6379/0
#   Per C11 the cluster's HA Redis runs Sentinel quorum on
#   rishi-4/5/6; password embedded in the URL.
# Source: local=.env.local (local docker-compose Redis can use 'devpassword' or empty)
#         ci=GitHub Secret REDIS_URL
#         production=GitHub Secret REDIS_URL → Swarm secret at deploy
REDIS_URL=

# REDIS_PASSWORD
#   Password sent to the Redis primary in response to its AUTH
#   challenge. The v2 cluster's Redis primary runs with
#   `--requirepass` enabled; every connection to the primary
#   MUST AUTH or first command raises
#   `redis.exceptions.AuthenticationError: Authentication required.`
#   Consumed by `app/idempotency.py`'s Sentinel `master_for(...)`
#   call when `REDIS_SENTINEL_ENABLED=true`. Local dev's
#   docker-compose Redis is unauthenticated so this secret stays
#   empty there.
# Source: local=Not required — local docker-compose Redis runs without --requirepass
#         ci=GitHub Secret REDIS_PASSWORD
#         production=Swarm secret yral_v2_redis_primary_password_<sha> mapped to logical name REDIS_PASSWORD via compose external:name
REDIS_PASSWORD=

# SENTRY_DSN
#   Sentry DSN for THIS service's project at sentry.rishi.yral.com
#   (NOT apm.yral.com per A7). The middleware (added Day 2) auto-tags
#   every event with service=yral-rishi-agent-conversation-turn-orchestrator per D3.
# Source: local=.env.local (use a dev Sentry project so local errors don't pollute prod)
#         ci=GitHub Secret SENTRY_DSN
#         production=GitHub Secret SENTRY_DSN → Swarm secret at deploy
SENTRY_DSN=

# LANGFUSE_PUBLIC_KEY
#   Langfuse project public key. Identifies which Langfuse project the
#   service's LLM traces land in. Paired with LANGFUSE_SECRET_KEY.
#   Per D4 every service auto-traces LLM calls to langfuse.rishi.yral.com.
# Source: local=.env.local (optional — LANGFUSE_TRACING_ENABLED=false locally avoids needing real keys)
#         ci=GitHub Secret LANGFUSE_PUBLIC_KEY
#         production=GitHub Secret LANGFUSE_PUBLIC_KEY → Swarm secret at deploy
LANGFUSE_PUBLIC_KEY=

# LANGFUSE_SECRET_KEY
#   Langfuse project secret key. Paired with LANGFUSE_PUBLIC_KEY. The
#   SDK signs every trace-ingestion call with this key.
# Source: local=.env.local (optional — see LANGFUSE_PUBLIC_KEY above)
#         ci=GitHub Secret LANGFUSE_SECRET_KEY
#         production=GitHub Secret LANGFUSE_SECRET_KEY → Swarm secret at deploy
LANGFUSE_SECRET_KEY=

# GEMINI_API_KEY
#   Auth key for the Google Gemini API. Used by `app/llm_client/gemini.py`
#   to generate assistant replies on the default-tier path (per the
#   Session-4 agent definition's Day-5 plan: "default → Gemini Flash";
#   Tara → OpenRouter routing lands Day 6+). Per A10 every LLM call
#   runs through the abstract `LlmClient` interface; this secret only
#   reaches the Gemini provider.
# Source: local=.env.local (use a personal Google AI Studio key for laptop testing; or leave empty + the gemini provider refuses to init)
#         ci=GitHub Secret GEMINI_API_KEY
#         production=GitHub Secret GEMINI_API_KEY → Swarm secret at deploy
GEMINI_API_KEY=

# OPENROUTER_API_KEY
#   Auth key for the OpenRouter LLM API. Used by `app/llm_client/openrouter.py`
#   (Day-6+) for the two A10 routing paths that send traffic to OpenRouter
#   rather than Gemini: (1) Tara via the per-influencer rule in
#   `llm_routing_rule`; (2) any influencer with `is_nsfw=TRUE` per the
#   preserved-from-chat-ai NSFW routing. All other influencers default
#   to Gemini Flash + Claude (crisis) and do NOT use this secret. PHASE
#   1 scope per the 2026-05-23 correction (originally deferred to Phase
#   2 in error; corrected back because chat-ai uses OpenRouter for Tara
#   today + A8 feature parity requires v2 to do the same from Phase 1).
# Source: local=.env.local (use a personal OpenRouter key for laptop testing; or leave empty + Tara + NSFW influencer routes will refuse to init at request time)
#         ci=GitHub Secret OPENROUTER_API_KEY
#         production=GitHub Secret OPENROUTER_API_KEY → Swarm secret at deploy
OPENROUTER_API_KEY=
