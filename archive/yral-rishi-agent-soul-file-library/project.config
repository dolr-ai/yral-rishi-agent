# ===========================================================================
# project.config — the SINGLE source of truth for per-service values.
# ===========================================================================
#
# ⭐ START HERE: every project-specific value lives in this ONE file.
# When a service is spawned by `scripts/new-service.sh` (Day 3), the
# spawner edits THIS FILE; everything else (compose, secrets, CI workflows,
# Caddy snippets) references these values via ${VAR} substitution.
#
# WHAT KINDS OF VALUES GO HERE?
#   - Service name + public domain
#   - Postgres database + schema names
#   - Docker / Swarm stack + overlay names
#   - GHCR image references
#   - Per-service backup settings
#
# WHAT DOES NOT GO HERE?
#   - Secrets (those live in `secrets.yaml` + GitHub Secrets per D8)
#   - Cross-service shared values (those live in `shared-config.yaml` per C7)
#   - Cluster-wide infra values (those live in
#     `bootstrap-scripts-for-the-v2-docker-swarm-cluster/` per F7)
#
# WHO READS THIS FILE?
#   - `local/setup.sh` (sources it: `set -a; source ./project.config; set +a`)
#   - CI workflows (parse into `$GITHUB_ENV` at job start)
#   - `docker stack deploy` (Compose interpolates ${VAR} from environment)
#   - `scripts/render-caddy-snippet.sh` (substitutes PROJECT_DOMAIN)
#
# FILE FORMAT RULES (strict):
#   - Every line is `KEY=value` — no spaces around `=`, no inline comments
#   - Use UPPER_SNAKE_CASE keys (per B1) — every word reads as English
#   - Values that contain spaces or special chars: wrap in double quotes
#   - Comments go on their own line above the value they describe
#
# RELATED FILES (footer at the end).
# ===========================================================================


# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# The bare project name. Lowercase, alphanumeric, hyphens. Used as the
# subdomain prefix and as the suffix of many other identifiers below.
# `new-service.sh` overwrites this with the spawned service's name.
PROJECT_NAME=yral-rishi-agent-soul-file-library

# The full public domain. Becomes the host in the Caddy snippet on
# rishi-1/2 (per A2 carve-out + C5) so the service is reachable from
# the internet. Uses the full PROJECT_NAME as the subdomain so the
# spawner's existing `yral-rishi-agent-soul-file-library` →
# `<new-name>` substitution catches it. Production mobile traffic
# flows through `agent.rishi.yral.com` (per A15); this per-service
# value is mostly informational + lets status pages have stable URLs.
PROJECT_DOMAIN=yral-rishi-agent-soul-file-library.rishi.yral.com

# The git repo / GitHub Container Registry path. Since v2 is a monorepo
# (per F16), every service shares the same repo but each service has
# its OWN image. The image suffix uses PROJECT_NAME.
PROJECT_REPO=yral-rishi-agent


# ---------------------------------------------------------------------------
# Postgres (per-service schema on the shared Patroni cluster, per F3)
# ---------------------------------------------------------------------------

# Postgres schema this service owns. Must use underscores, not hyphens
# (Postgres identifier rule). All tables for this service live under
# this schema name: e.g. <SCHEMA>.users, <SCHEMA>.events.
POSTGRES_SCHEMA=soul_file_library

# Postgres role this service connects AS. Has GRANTs only on its own
# schema (per F3 — schema isolation within the shared cluster).
POSTGRES_ROLE=soul_file_library_role

# Max concurrent connections this service may hold open against the
# shared cluster. Counts toward the cluster's connection budget.
# Most services need 10-25; orchestrator + public-api need more.
POSTGRES_CONNECTION_LIMIT=15


# ---------------------------------------------------------------------------
# Docker Swarm
# ---------------------------------------------------------------------------

# Docker Swarm stack name. MUST be globally unique within the Swarm —
# Swarm uses this as the prefix for every container/network/volume the
# stack creates.
SWARM_STACK=yral-rishi-agent-soul-file-library

# The container registry image this service pulls from in production.
# CI builds + pushes here per F13.
IMAGE_REPO=ghcr.io/dolr-ai/yral-rishi-agent-soul-file-library


# ---------------------------------------------------------------------------
# Sentry (per A7 + D3)
# ---------------------------------------------------------------------------

# Service tag stamped on every Sentry event so we can filter by service
# in the Sentry UI. Per D3 — every v2 service tags `service=<name>`.
# The DSN itself is a secret (declared in secrets.yaml).
SENTRY_SERVICE_TAG=yral-rishi-agent-soul-file-library


# ---------------------------------------------------------------------------
# Resource sizing (per-replica caps used by docker-compose.swarm.yml)
# ---------------------------------------------------------------------------

# CPU + memory limits per replica. Tune per service after first week of
# prod data. These defaults are conservative starting points.
RESOURCE_LIMIT_CPUS=1.0
RESOURCE_LIMIT_MEMORY=512M
RESOURCE_RESERVATION_CPUS=0.25
RESOURCE_RESERVATION_MEMORY=128M

# Replica count. Default 3 per G2 (horizontal scale from day 1).
# Services with hot paths (public-api, orchestrator) may bump higher.
REPLICA_COUNT=3


# ---------------------------------------------------------------------------
# Backup (per D2 — 3-layer backup; this row is for the L3 per-service dump)
# ---------------------------------------------------------------------------

# S3-compatible endpoint + bucket. NOT secrets (just URLs/names). The
# actual access keys live in GitHub Secrets as BACKUP_S3_ACCESS_KEY +
# BACKUP_S3_SECRET_KEY (shared across services, declared once in
# shared-config.yaml).
#
# Per-service backups go under s3://<bucket>/<PROJECT_NAME>/daily/ so
# services never overlap.
BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
BACKUP_S3_BUCKET=rishi-yral
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=4


# ---------------------------------------------------------------------------
# Feature flags this service ships with (per F11)
# ---------------------------------------------------------------------------

# Set to "true" if this service exposes an HTTP API + needs the auth
# middleware path. Stateless workers / consumers set "false" to skip
# the JWT validation overhead.
ENABLE_AUTH_MIDDLEWARE=true

# Set to "true" if this service writes Redis Streams events.
ENABLE_EVENT_STREAM_PRODUCER=false

# Set to "true" if this service reads Redis Streams events.
ENABLE_EVENT_STREAM_CONSUMER=false


# ===========================================================================
# RELATED FILES (read these next):
#   shared-config.yaml          — cross-service shared values (per C7)
#   secrets.yaml.template       — per-service secret declarations (per D8)
#   docker-compose.yml          — local dev wiring
#   docker-compose.swarm.yml    — production Swarm wiring; reads ${VAR} from here
#   pyproject.toml              — Python deps the running service needs
#   bootstrap-scripts-for-the-v2-docker-swarm-cluster/cluster.hosts.yaml
#                                — cluster-wide values (rishi-N hostnames, etc.)
# ===========================================================================
