# ===========================================================================
# .env.example — list of local-dev env vars devs override in .env.local.
# ===========================================================================
#
# WHAT THIS FILE IS FOR
# A copy-pastable template a dev uses to bootstrap their local environment.
# Workflow:
#   1. `cp .env.example .env.local`
#   2. Fill in real values in `.env.local` (which is gitignored)
#   3. `docker compose up --build` reads from `.env.local`
#
# IMPORTANT — DO NOT EDIT BY HAND AFTER DAY 3
# Once `scripts/gen-env-example.sh` is in place (Day 3), it regenerates
# this file from `secrets.yaml`. Editing it manually then risks drift —
# the CI `lint-secrets-hygiene.yml` workflow fails if this file no longer
# matches what `secrets.yaml` declares.
#
# Today (Day 1), this file is hand-written to MATCH `secrets.yaml.template`
# — same 5 keys + the non-secret env vars from docker-compose.yml. Day 3's
# generator script will replace it + verify-no-drift on every PR.
#
# Each variable below has 3 lines: the name (commented), a short
# description, and the source-per-env line straight from secrets.yaml.
#
# RELATED FILES (footer at the end).
# ===========================================================================


# ---------------------------------------------------------------------------
# Non-secret runtime configuration (NOT in secrets.yaml — just env wiring)
# ---------------------------------------------------------------------------

# ENVIRONMENT — one of: local | staging | production. Picked up by
# logging, Sentry tagging, feature-flag defaults.
ENVIRONMENT=local

# LOG_LEVEL — Python logging level. INFO for normal dev; DEBUG when
# digging into a specific issue.
LOG_LEVEL=INFO

# LANGFUSE_TRACING_ENABLED — set "false" locally so the SDK no-ops and
# you don't need real LANGFUSE_*_KEY values during normal dev.
LANGFUSE_TRACING_ENABLED=false


# ---------------------------------------------------------------------------
# Secrets (matched 1-to-1 with secrets.yaml.template)
# ---------------------------------------------------------------------------

# DATABASE_URL — Postgres connection string this service uses to reach
# its own schema on the shared Patroni cluster (via pgBouncer).
# Source: .env.local | GitHub Secret DATABASE_URL | Swarm secret at deploy
DATABASE_URL=

# REDIS_SENTINEL_PASSWORD — Auth password for the Redis Sentinel cluster
# (per C11). The local docker-compose Redis is unauthenticated, so this
# can be left empty for local dev.
# Source: .env.local | GitHub Secret REDIS_SENTINEL_PASSWORD | Swarm secret
REDIS_SENTINEL_PASSWORD=

# SENTRY_DSN — Sentry DSN for THIS service's project at
# sentry.rishi.yral.com (NOT apm.yral.com per A7). Leave empty locally
# so the SDK no-ops.
# Source: .env.local | GitHub Secret SENTRY_DSN | Swarm secret at deploy
SENTRY_DSN=

# LANGFUSE_PUBLIC_KEY — Langfuse project public key. Per D4 every service
# auto-traces LLM calls. Leave empty locally (the SDK is disabled above).
# Source: .env.local | GitHub Secret LANGFUSE_PUBLIC_KEY | Swarm secret
LANGFUSE_PUBLIC_KEY=

# LANGFUSE_SECRET_KEY — Langfuse project secret key. Paired with
# LANGFUSE_PUBLIC_KEY. Leave empty locally.
# Source: .env.local | GitHub Secret LANGFUSE_SECRET_KEY | Swarm secret
LANGFUSE_SECRET_KEY=


# ===========================================================================
# RELATED FILES:
#   secrets.yaml.template — declarations this file mirrors
#   docker-compose.yml    — reads .env.local at `docker compose up`
#   project.config        — per-service non-secret values
#   shared-config.yaml    — cross-service shared values
# ===========================================================================
