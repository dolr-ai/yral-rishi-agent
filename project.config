PROJECT_NAME=agent
PROJECT_DOMAIN=agent.rishi.yral.com
PROJECT_REPO=yral-rishi-agent
POSTGRES_DB=yral_agent_db
PATRONI_SCOPE=agent-cluster
ETCD_TOKEN=agent-etcd-cluster
SWARM_STACK=postgres
OVERLAY_NETWORK=agent-db-internal
IMAGE_REPO=ghcr.io/dolr-ai/yral-rishi-agent
