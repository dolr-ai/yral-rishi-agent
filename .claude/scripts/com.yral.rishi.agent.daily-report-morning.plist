<?xml version="1.0" encoding="UTF-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  LAUNCHD JOB: com.yral.rishi.agent.daily-report-morning              ║
  ║                                                                      ║
  ║  ⭐ THIS FILE IN ONE SENTENCE                                        ║
  ║  Triggers the daily report (morning kind) at 9:00 IST every day.    ║
  ║                                                                      ║
  ║  📖 EXPLAINED FOR A NON-PROGRAMMER                                   ║
  ║  launchd = macOS's cron. Every day at 9:00 local time (which is    ║
  ║  IST for Rishi's Mac), this fires generate-daily-report.sh with    ║
  ║  REPORT_KIND=morning in its env. The script emails + Google-Chats  ║
  ║  the report.                                                         ║
  ║                                                                      ║
  ║  🔧 INSTALL (Rishi runs once, OR coordinator under autonomy)         ║
  ║  cp .claude/scripts/com.yral.rishi.agent.daily-report-morning.plist \║
  ║     ~/Library/LaunchAgents/                                          ║
  ║  launchctl bootstrap gui/$(id -u) \                                  ║
  ║    ~/Library/LaunchAgents/com.yral.rishi.agent.daily-report-morning.plist
  ║                                                                      ║
  ║  🔧 UNINSTALL (if you ever need)                                     ║
  ║  launchctl bootterminate gui/$(id -u)/com.yral.rishi.agent.daily-report-morning
  ║  rm ~/Library/LaunchAgents/com.yral.rishi.agent.daily-report-morning.plist
  ║                                                                      ║
  ║  ⚠️ DESIGN NOTE (2026-05-18 — fixed)                                  ║
  ║  Prior version wrapped the script call via `bash -c "VAR=val ..."`  ║
  ║  which launchd-on-Sequoia rejects with EIO. Working pattern is to   ║
  ║  call the script DIRECTLY (as ProgramArguments) and put env vars    ║
  ║  in the EnvironmentVariables dict where launchd parses them safely. ║
  ║                                                                      ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yral.rishi.agent.daily-report-morning</string>

    <!-- Direct script call (NOT wrapped in bash -c); spaces in path are
         safe inside <string> elements without escaping. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rishichadha/Claude Projects/yral-rishi-agent/.claude/scripts/generate-daily-report.sh</string>
    </array>

    <!-- 9:00 IST (Rishi's Mac is set to IST) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Environment variables passed to the script.
         REPORT_KIND is the morning/evening discriminator.
         PATH + HOME are needed because launchd inherits a minimal env. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>REPORT_KIND</key>
        <string>morning</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/rishichadha</string>
    </dict>

    <!-- Logs go to /tmp so we can debug failed runs -->
    <key>StandardOutPath</key>
    <string>/tmp/yral-v2-daily-report-morning.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/yral-v2-daily-report-morning.err</string>

    <!-- Don't run on Mac wake-up if it missed the schedule overnight.
         Run NEXT time the schedule hits. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
