# ===========================================================================
# project.config — per-service runtime values for user-memory-service.
# ===========================================================================
#
# ⭐ START HERE: every project-specific non-secret value lives here.
# When CI deploys to the cluster it sources this file (`set -a; source
# ./project.config; set +a`) then runs `docker stack deploy`.
#
# WHAT GOES HERE: service name, domain, Postgres schema/role, Swarm
# stack name, GHCR image repo, Sentry tag, resource sizing.
# WHAT DOES NOT: secrets (in secrets.yaml) + cross-service shared values
# (in shared-config.yaml) + cluster-wide infra (in bootstrap/).
#
# RELATED FILES (footer at end).
# ===========================================================================

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

PROJECT_NAME=yral-rishi-agent-user-memory-service
PROJECT_DOMAIN=yral-rishi-agent-user-memory-service.rishi.yral.com
PROJECT_REPO=yral-rishi-agent


# ---------------------------------------------------------------------------
# Postgres (per F3 — per-service schema on shared Patroni cluster)
# ---------------------------------------------------------------------------

# Schema this service owns. All conversations + messages tables live here.
POSTGRES_SCHEMA=user_memory

# Postgres role this service connects as. GRANTs restricted to POSTGRES_SCHEMA.
# This role + the user_memory database must be provisioned by coordinator /
# Session 1 before first deploy. See DEP-011 in cross-session-dependencies.md.
POSTGRES_ROLE=user_memory_role

# Max concurrent connections. Conversation + message writes are sequential
# per turn; 15 handles the burst from 3 replicas × 5 concurrent hot-path
# requests each. Tune upward after first week of prod data.
POSTGRES_CONNECTION_LIMIT=15


# ---------------------------------------------------------------------------
# Docker Swarm
# ---------------------------------------------------------------------------

SWARM_STACK=yral-rishi-agent-user-memory-service
IMAGE_REPO=ghcr.io/dolr-ai/yral-rishi-agent-user-memory-service


# ---------------------------------------------------------------------------
# Sentry (per A7 + D3)
# ---------------------------------------------------------------------------

SENTRY_SERVICE_TAG=yral-rishi-agent-user-memory-service


# ---------------------------------------------------------------------------
# Resource sizing
# ---------------------------------------------------------------------------

RESOURCE_LIMIT_CPUS=1.0
RESOURCE_LIMIT_MEMORY=512M
RESOURCE_RESERVATION_CPUS=0.25
RESOURCE_RESERVATION_MEMORY=128M
REPLICA_COUNT=3


# ---------------------------------------------------------------------------
# Backup (per D2 — 3-layer backup)
# ---------------------------------------------------------------------------

BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
BACKUP_S3_BUCKET=rishi-yral
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=4


# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

ENABLE_AUTH_MIDDLEWARE=true
ENABLE_EVENT_STREAM_PRODUCER=false
ENABLE_EVENT_STREAM_CONSUMER=false


# ===========================================================================
# RELATED FILES:
#   secrets.yaml             — per-service secret declarations
#   docker-compose.swarm.yml — reads ${VAR} from here at deploy time
#   pyproject.toml           — Python deps
# ===========================================================================
