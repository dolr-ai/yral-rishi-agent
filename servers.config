# v2 cluster runs on rishi-4/5/6 (separate from chat-ai's rishi-1/2/3)
# Caddy on rishi-1/2 already routes agent.rishi.yral.com → rishi-4/5
# IPs are in GitHub Secrets (RISHI_4_PUBLIC_IPV4, RISHI_5_PUBLIC_IPV4, RISHI_6_PUBLIC_IPV4)

APP_SERVERS=rishi-4,rishi-5
CADDY_HOSTS=rishi-1,rishi-2
DB_SERVERS=rishi-4,rishi-5,rishi-6

DEPLOY_USER=deploy
SSH_KEY_PATH=~/.ssh/rishi-hetzner-ci-key
