# The fleet — every server the Swarm runs on.
#
# ONE LINE PER NODE, four whitespace-separated columns:
#
#     hostname   role      ssh_user       public_ipv4
#
#   role       manager = Raft voter, holds cluster state and can be deployed
#              to; worker = runs containers only. Keep managers ODD so Raft
#              keeps a majority when one dies. 3 managers tolerate 1 loss,
#              5 tolerate 2. Adding workers never affects quorum.
#   ssh_user   the account CI and operators log in as. It differs by node
#              because 1/2/3 were built for chat-ai and 4/5/6 for v2.
#
# ADDING A SERVER IS ADDING A LINE HERE. Nothing else in the repo should learn
# a new address by hand — `scripts/ci/check_fleet_inventory.py` fails CI if a
# workflow or script names a host that is not listed below.
#
# That check is the point of this file. Its previous version claimed the app
# ran on rishi-4/5 with user `deploy`, and was wrong on every line for five
# months — because nothing read it and nothing checked it. A list only stays
# true if something breaks when it stops being true.

FLEET_NODES="
rishi-1  worker   deploy        138.201.137.181
rishi-2  worker   deploy        136.243.150.84
rishi-3  worker   deploy        136.243.147.225
rishi-4  manager  rishi-deploy  138.201.128.108
rishi-5  manager  rishi-deploy  88.99.160.251
rishi-6  manager  rishi-deploy  162.55.88.112
"

# Derived views — nothing below needs editing when a node is added or removed.

fleet_column() {
    # fleet_column <column-number> [role]
    echo "${FLEET_NODES}" | awk -v col="$1" -v want="${2:-}" \
        'NF == 4 && (want == "" || $2 == want) { print $col }'
}

FLEET_HOSTNAMES="$(fleet_column 1 | tr '\n' ' ')"
FLEET_IPS="$(fleet_column 4 | tr '\n' ' ')"
FLEET_MANAGER_IPS="$(fleet_column 4 manager | tr '\n' ' ')"
FLEET_WORKER_IPS="$(fleet_column 4 worker | tr '\n' ' ')"

# The SSH account on the managers, which is where CI deploys from. Workers are
# reached through the Swarm, not directly, so CI needs only this one.
SWARM_USER=rishi-deploy
