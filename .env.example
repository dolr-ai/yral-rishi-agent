# Database (Patroni on rishi-4/5/6)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/chat_ai_db

# Sentry (sentry.rishi.yral.com)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_RATE=1.0
SENTRY_PROFILES_RATE=1.0

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# S3 (Hetzner Object Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-central-1
S3_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=

# Replicate (image generation)
REPLICATE_API_TOKEN=

# Push notifications
METADATA_URL=https://metadata.yral.com
YRAL_METADATA_NOTIFICATION_API_KEY=

# Admin
ADMIN_KEY_TO_DELETE_INFLUENCER=

# Google Chat webhook
GOOGLE_CHAT_WEBHOOK_URL=

# CORS
CORS_ORIGINS=*
