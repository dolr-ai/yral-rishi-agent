# .env.example
# AUTO-GENERATED from secrets.yaml by scripts/gen-env-example.sh.
# DO NOT EDIT BY HAND — your changes will be overwritten on the next run.
#
# To use locally:
#   cp .env.example .env.local
#   Then fill in REAL VALUES in .env.local (which is gitignored).

# ---------------------------------------------------------------------------
# Non-secret runtime configuration (NOT in secrets.yaml — just env wiring)
# ---------------------------------------------------------------------------

# ENVIRONMENT — one of: local | staging | production.
ENVIRONMENT=local

# LOG_LEVEL — Python logging threshold (DEBUG | INFO | WARNING | ERROR).
LOG_LEVEL=INFO

# LANGFUSE_TRACING_ENABLED — set "true" to ship LLM traces to rishi-6.
# Default "false" so local dev doesn't need real Langfuse keys.
LANGFUSE_TRACING_ENABLED=false


# ---------------------------------------------------------------------------
# Secrets (1-to-1 with secrets.yaml declarations)
# ---------------------------------------------------------------------------

# POSTGRES_CONNECTION_STRING_INFLUENCER_AND_PROFILE_DIRECTORY
#   Postgres connection string the influencer-and-profile-directory
#   uses to reach its OWN per-service Postgres database on the shared
#   Patroni cluster. asyncpg-compatible format:
#     postgresql://<role>:<password>@<pgbouncer-host>:5432/<database>
#   Per F3 the cluster is shared but each service is restricted to its
#   own role + database via Postgres GRANTs; pgBouncer fronts the pool
#   per G3. Per D8 the secret name carries the service-name suffix
#   (`_INFLUENCER_AND_PROFILE_DIRECTORY`) so a leaked secret is
#   unambiguous about which service's blast-radius applies. Same
#   runtime + Alembic dual-consumer pattern as the soul-file-library's
#   equivalent secret (POSTGRES_CONNECTION_STRING_SOUL_FILE_LIBRARY).
# Source: local=.env.local (point at the local docker-compose Postgres+pgbouncer pair)
#         ci=GitHub Secret POSTGRES_CONNECTION_STRING_INFLUENCER_AND_PROFILE_DIRECTORY
#         production=GitHub Secret POSTGRES_CONNECTION_STRING_INFLUENCER_AND_PROFILE_DIRECTORY → Swarm secret at deploy
POSTGRES_CONNECTION_STRING_INFLUENCER_AND_PROFILE_DIRECTORY=

# SENTRY_DSN
#   Sentry DSN for THIS service's project at sentry.rishi.yral.com
#   (NOT apm.yral.com per A7). The middleware (added Day 2) auto-tags
#   every event with service=yral-rishi-agent-influencer-and-profile-directory per D3.
# Source: local=.env.local (use a dev Sentry project so local errors don't pollute prod)
#         ci=GitHub Secret SENTRY_DSN
#         production=GitHub Secret SENTRY_DSN → Swarm secret at deploy
SENTRY_DSN=

# LANGFUSE_PUBLIC_KEY
#   Langfuse project public key. Identifies which Langfuse project the
#   service's LLM traces land in. Paired with LANGFUSE_SECRET_KEY.
#   Per D4 every service auto-traces LLM calls to langfuse.rishi.yral.com.
# Source: local=.env.local (optional — LANGFUSE_TRACING_ENABLED=false locally avoids needing real keys)
#         ci=GitHub Secret LANGFUSE_PUBLIC_KEY
#         production=GitHub Secret LANGFUSE_PUBLIC_KEY → Swarm secret at deploy
LANGFUSE_PUBLIC_KEY=

# LANGFUSE_SECRET_KEY
#   Langfuse project secret key. Paired with LANGFUSE_PUBLIC_KEY. The
#   SDK signs every trace-ingestion call with this key.
# Source: local=.env.local (optional — see LANGFUSE_PUBLIC_KEY above)
#         ci=GitHub Secret LANGFUSE_SECRET_KEY
#         production=GitHub Secret LANGFUSE_SECRET_KEY → Swarm secret at deploy
LANGFUSE_SECRET_KEY=
